{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cli.schema.json",
  "title": "Контракт CLI",
  "description": "Целевой JSON-контракт команд и ответов локальной программы. CLI-адаптер в практике 3 не реализован.",
  "$defs": {
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "stop"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "stop": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "importCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "observatoryId",
        "publicationState",
        "cadence",
        "components",
        "timeRange",
        "idempotencyKey"
      ],
      "properties": {
        "command": {
          "const": "import"
        },
        "observatoryId": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Трёхбуквенный IAGA-код обсерватории."
        },
        "publicationState": {
          "type": "string",
          "enum": [
            "adjusted",
            "definitive",
            "quasi-def",
            "reported",
            "best-avail"
          ]
        },
        "cadence": {
          "type": "string",
          "enum": ["PT1M", "PT1S"]
        },
        "components": {
          "type": "string",
          "enum": ["xyzf", "hdzf", "diff", "native"]
        },
        "timeRange": {
          "$ref": "#/$defs/timeRange"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "processCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "rawDatasetId",
        "methodId",
        "parameters",
        "idempotencyKey"
      ],
      "properties": {
        "command": {
          "const": "process"
        },
        "rawDatasetId": {
          "type": "string",
          "minLength": 1
        },
        "methodId": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "queryCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "datasetKind"],
      "properties": {
        "command": {
          "const": "query"
        },
        "datasetKind": {
          "type": "string",
          "enum": ["raw", "processed"]
        },
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "observatoryId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRawDatasetId": {
          "type": "string",
          "minLength": 1
        },
        "timeRange": {
          "$ref": "#/$defs/timeRange"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["datasetId"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["limit"]
                },
                {
                  "required": ["cursor"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "datasetKind": {
                "const": "raw"
              }
            },
            "required": ["datasetKind"]
          },
          "then": {
            "not": {
              "required": ["sourceRawDatasetId"]
            }
          }
        }
      ]
    },
    "jobStatusCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "jobId"],
      "properties": {
        "command": {
          "const": "job-status"
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "invalid_command",
        "unknown_operation",
        "operation_already_registered",
        "invalid_parameters",
        "invalid_import_request",
        "dataset_unavailable",
        "intermagnet_request_rejected",
        "intermagnet_unavailable",
        "intermagnet_invalid_response",
        "invalid_processing_request",
        "raw_dataset_not_found",
        "method_not_supported",
        "processing_input_invalid",
        "processing_failed",
        "invalid_query",
        "dataset_not_found",
        "invalid_job_transition",
        "idempotency_conflict",
        "job_not_found",
        "job_interrupted",
        "storage_error",
        "internal_error"
      ]
    },
    "errorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "code", "message"],
      "properties": {
        "ok": {
          "const": false
        },
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "jobState": {
      "type": "string",
      "enum": [
        "Created",
        "Downloading",
        "Processing",
        "Completed",
        "Failed"
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "jobId", "kind", "status"],
      "properties": {
        "ok": {
          "const": true
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["import", "processing"]
        },
        "status": {
          "$ref": "#/$defs/jobState"
        },
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "$ref": "#/$defs/errorBody"
        }
      }
    },
    "datasetSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId",
        "datasetKind",
        "recordCount",
        "createdAt",
        "provenance"
      ],
      "properties": {
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "datasetKind": {
          "type": "string",
          "enum": ["raw", "processed"]
        },
        "observatoryId": {
          "type": ["string", "null"]
        },
        "sourceRawDatasetId": {
          "type": ["string", "null"]
        },
        "timeRange": {
          "oneOf": [
            {
              "$ref": "#/$defs/timeRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "object"
        }
      }
    },
    "datasetPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "items"],
      "properties": {
        "ok": {
          "const": true
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/datasetSummary"
          }
        },
        "nextCursor": {
          "type": ["string", "null"]
        }
      }
    },
    "datasetDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "datasetId",
        "datasetKind",
        "recordCount",
        "createdAt",
        "provenance",
        "content"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "datasetKind": {
          "type": "string",
          "enum": ["raw", "processed"]
        },
        "observatoryId": {
          "type": ["string", "null"]
        },
        "sourceRawDatasetId": {
          "type": ["string", "null"]
        },
        "timeRange": {
          "oneOf": [
            {
              "$ref": "#/$defs/timeRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "object"
        },
        "content": {
          "type": "object"
        }
      }
    },
    "jobStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "jobId", "status"],
      "properties": {
        "ok": {
          "const": true
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/jobState"
        },
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "$ref": "#/$defs/errorBody"
        }
      }
    },
    "request": {
      "oneOf": [
        {
          "$ref": "#/$defs/importCommand"
        },
        {
          "$ref": "#/$defs/processCommand"
        },
        {
          "$ref": "#/$defs/queryCommand"
        },
        {
          "$ref": "#/$defs/jobStatusCommand"
        }
      ]
    },
    "response": {
      "oneOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "$ref": "#/$defs/job"
        },
        {
          "$ref": "#/$defs/datasetPage"
        },
        {
          "$ref": "#/$defs/datasetDetail"
        },
        {
          "$ref": "#/$defs/jobStatus"
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}
